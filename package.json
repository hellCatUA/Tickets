{
  "name": "tickets",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @tickets/shared build && pnpm --filter @tickets/api build && pnpm --filter @tickets/web build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @tickets/api start:dev",
    "dev:web": "pnpm --filter @tickets/web dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "vue-demi"
    ]
  }
}
