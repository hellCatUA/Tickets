# --- Core ---
PUBLIC_URL=https://tickets.417group.org
PORT=3000
SESSION_SECRET=change-me-long-random-string

# --- Database / queue ---
DATABASE_URL=postgresql://tickets:change-me@db:5432/tickets
REDIS_URL=redis://redis:6379

# --- Nextcloud OIDC (SSO) ---
# Issuer as configured by the "OIDC Identity Provider" app on Nextcloud
OIDC_ISSUER=https://cloud.417group.org
# Optional explicit discovery URL; defaults to $OIDC_ISSUER/.well-known/openid-configuration
# OIDC_DISCOVERY_URL=https://cloud.417group.org/index.php/.well-known/openid-configuration
OIDC_CLIENT_ID=tickets
OIDC_CLIENT_SECRET=change-me
OIDC_GROUPS_CLAIM=groups

# --- Nextcloud OCS directory sync (service account + app password) ---
NC_BASE_URL=https://cloud.417group.org
NC_SERVICE_ACCOUNT=svc-tickets
NC_SERVICE_APP_PASSWORD=change-me
# Cron for the directory sync job
SYNC_CRON=*/15 * * * *
# Members of this Nextcloud group get the Admin role before any mapping exists
BOOTSTRAP_ADMIN_GROUP=tickets-admins

# --- Docker compose only ---
DB_PASSWORD=change-me
